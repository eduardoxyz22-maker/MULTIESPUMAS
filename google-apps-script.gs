  if (b.leads.length > 1) return kcDudas_(m, uid, ocupado, out, 'dos', b.leads, false);
  if (body.crear) return kcCrear_(m, rec, id, uid, total, b.contactos, out);
  return kcDudas_(m, uid, ocupado, out, 'ninguno', [], true);
