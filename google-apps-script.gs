        var r = kPedir_('get', '/leads?filter[statuses][0][pipeline_id]=' + encodeURIComponent(m.embudo) + '&filter[statuses][0][status_id]=' + encodeURIComponent(m.etapa) + '&order[updated_at]=desc&limit=5');
