/* 📏 (2026-11-16-a, revisión de Fable) EL MENSAJE ENTERO TAMBIÉN TIENE TOPE. Cada dato va hasta 250 letras (`waParam_`), pero Meta acepta
   como mucho 1.024 en el cuerpo YA RELLENADO de la plantilla: `cierre_del_dia_v3` tiene ~215 de texto fijo y 9 datos, y con 7-8 vendedoras
   y «por qué se movió» se pasaba. Meta contestaba el error 132005 y ese día el cierre no salía. Ahora, antes de mandar, el cuerpo (texto fijo
   + datos) se deja en WA_CUERPO_TOPE (1.000: margen para lo que Meta cuente distinto; un emoji acá cuenta 2): se recortan PAREJO los datos
   más largos (todos los que pasan de un mismo largo), cortando por « · » o «, » si se puede y con «…» al final. Vale para la plantilla y
   para cada respaldo (que manda los primeros datos de la misma lista). Una plantilla que no está en WA_PLANTILLAS no se toca. */
var WA_CUERPO_TOPE = 1000;
var WA_PARAM_MIN = 40;          // un dato no se recorta a menos de esto (si igual no entra, va lo más corto posible)
/** El largo del texto fijo de la plantilla (sin los {{n}}); -1 si no está en WA_PLANTILLAS. */
function waPlantillaFijo_(nombre) {
  for (var i = 0; i < WA_PLANTILLAS.length; i++) if (WA_PLANTILLAS[i].n === nombre) return String(WA_PLANTILLAS[i].t || '').replace(/\{\{\d+\}\}/g, '').length;
  return -1;
}
/** `s` en `n` letras como mucho, con «…» al final: por « · », «, », « — » o «; » si así se pierde poco (el corte en el último 40 %); si no,
    entre dos palabras; si tampoco, donde caiga (sin partir un emoji). */
function waRecorte_(s, n) {
  s = String(s == null ? '' : s);
  if (s.length <= n) return s;
  if (n < 2) return '…';
  var cab = iaCorte_(s, n - 1), mejor = -1, piso = Math.floor(n * 0.6);
  [' · ', ', ', ' — ', '; '].forEach(function (c) { var k = cab.lastIndexOf(c); if (k > mejor) mejor = k; });
  if (mejor >= piso) cab = cab.slice(0, mejor);
  else if (cab.lastIndexOf(' ') >= piso) cab = cab.slice(0, cab.lastIndexOf(' '));
  cab = cab.replace(/[\s·,;—]+$/, '');
  return (cab || iaCorte_(s, n - 1)) + '…';
}
/** Los datos recortados para que `fijo` + la suma de sus largos quede en `tope`. Recorta parejo: busca el largo L más grande con el que
    entran todos (cada dato que pasa de L, recortado a L con `waRecorte_`) y corta solo los que pasan. */
function waCuerpoTope_(fijo, params, tope) {
  var P = (params || []).map(function (x) { return String(x == null ? '' : x); });
  tope = tope || WA_CUERPO_TOPE;
  var lugar = tope - (Number(fijo) || 0), max = 0;
  var corta = function (L) { return P.map(function (x) { return x.length > L ? waRecorte_(x, L) : x; }); };
  var suma = function (A) { var t = 0; A.forEach(function (x) { t += x.length; }); return t; };
  P.forEach(function (x) { if (x.length > max) max = x.length; });
  if (suma(P) <= lugar) return P;
  var cabe = function (L) { return suma(corta(L)) <= lugar; };
  var lo = WA_PARAM_MIN, hi = max;                     // el L más grande que entra (si ni con el mínimo entra, el mínimo)
  if (!cabe(lo)) hi = lo;
  else while (lo < hi) { var mid = Math.ceil((lo + hi) / 2); if (cabe(mid)) lo = mid; else hi = mid - 1; }
  var L = Math.max(WA_PARAM_MIN, lo), R = corta(L);
  while (suma(R) > lugar && L > WA_PARAM_MIN) { L--; R = corta(L); }   // por si un corte por « · » no es parejo
  return R;
}
/** Lo mismo para la plantilla y sus respaldos: `cands` = [[plantilla, cuántos datos manda]]. */
function waCuerpoTopeTodas_(cands, params) {
  var P = (params || []).slice();
  (cands || []).forEach(function (c) {
    if (!c || !c[0]) return;
    var fijo = waPlantillaFijo_(c[0]); if (fijo < 0) return;
    var n = Math.min(Number(c[1]) || P.length, P.length), parte = waCuerpoTope_(fijo, P.slice(0, n), WA_CUERPO_TOPE);
    for (var i = 0; i < n; i++) P[i] = parte[i];
  });
  return P;
}
/** ¿Es una ENTREGA? (para logística): con fecha, sin entregar, no del sistema, ni borrador de Kommo, ni venta de tienda. */
function waEsEntrega_(p) {
  var id = String((p && p.id) || '');
  /* (12/10, revisión) El borrador se reconoce por su ESTADO, no por el id: una venta de Kommo ya completada conserva el id
     `kommo-<lead>` y es una entrega como cualquier otra. */
  if (!p || !id || id.indexOf('__') === 0 || !p.fecha || p.entregado) return false;
  if (String(p.estado || '') === BORRADOR_EST) return false;
  if (entregaAConfirmar_(p)) return false;   // 📦 (2026-10-30-a) sin día: ni cliente, ni «sin camión», ni «pedir hoy», ni cierre (ya cae arriba por la fecha vacía; queda escrito)
  return waNorm_(p.direccion).indexOf('salio de tienda') !== 0 && waNorm_(p.zona) !== 'tienda';
}
/** Por qué NO se le manda al cliente: {m:'motivo', anotar:bool}, o null si se le manda. */
function waNoCliente_(p, hoy) {
  if (!waEsEntrega_(p)) return { m:'no es una entrega pendiente', anotar:false };
  if (/^(ATC|RPT)\b/i.test(String(p.oc || '').trim())) return { m:'ATC o RPT', anotar:false };
  var v = waNorm_(p.vendedor);
  if (v.indexOf('eduardo') >= 0) return { m:'cliente de Eduardo', anotar:false };   // (dueño, 11/10)
  if (v.indexOf('roho') >= 0) return { m:'pedido de ROHO', anotar:false };
  if (String(p.fecha) < hoy) return { m:'la fecha de entrega ya pasó', anotar:true };
  if (!waCel_(p.celular)) return { m:'no tiene un celular de WhatsApp anotado («' + String(p.celular || '').slice(0, 30) + '»)', anotar:true };
  return null;
}
function waConfig_() {
  var c = { token:prop_('WA_TOKEN'), phone:prop_('WA_PHONE_ID'), idioma:prop_('WA_IDIOMA') || 'es', api:prop_('WA_API') || 'v21.0',
            prueba:waCel_(prop_('WA_PRUEBA')), logistica:[], mal:[], pedirHoy:[], malPh:[] };
  var leer = function (prop, lista, mal) {
    prop_(prop).split(/[,;\n]+/).forEach(function (s) {
      s = s.trim(); if (!s) return;
      var i = s.indexOf(':'), nom = i >= 0 ? s.slice(0, i).trim() : '', cel = waCel_(i >= 0 ? s.slice(i + 1) : s);
      if (cel) lista.push({ nombre:nom || cel, cel:cel }); else mal.push(nom || s);
    });
  };
  leer('WA_LOGISTICA', c.logistica, c.mal);
  leer('WA_PEDIR_HOY', c.pedirHoy, c.malPh);   // 🏭 (2026-10-27-a) Ernesto y Alba
  c.avisos = []; c.malAv = [];
  leer('WA_AVISOS', c.avisos, c.malAv);        // 📥✅ (2026-10-29-a) opcional: si no está, el Excel y el cierre van a los de WA_PEDIR_HOY
  c.avisosLog = c.avisos.length ? c.avisos : c.pedirHoy;
  c.dueno = []; c.malDu = [];
  leer('WA_DUENO', c.dueno, c.malDu);          // 📉🏭 §4ok-102/105 (2026-11-05-a) opcional: el vigía de leads y el reclamo a la fábrica
  /* 👔 (2026-11-07-e) El dueño (07/11): su jefe también, «todo menos lo del efectivo». WA_DUENO puede tener varios («Eduardo:7…, Jefe:7…»):
     a TODOS les llegan el cierre del día (y el botón de los productos), el reclamo a la fábrica y la alerta de leads; el efectivo de los
     vendedores, solo al PRIMERO de la lista (el dueño). */
  c.duenoEfe = c.dueno.slice(0, 1);
  c.conta = []; c.malCo = [];
  leer('WA_CONTABILIDAD', c.conta, c.malCo);    // 🚚 (2026-11-06-c) opcional: el efectivo de los choferes sin rendir (sin ella, no va a nadie)
  /* 🏭 §4ok-105 El reclamo a la fábrica: al dueño y a los de los avisos de logística (WA_AVISOS, o WA_PEDIR_HOY), sin repetir un número. */
  c.reclamo = [];
  c.dueno.concat(c.avisosLog).forEach(function (L) { if (!c.reclamo.some(function (x) { return x.cel === L.cel; })) c.reclamo.push(L); });
  c.ok = !!(c.token && c.phone);
  return c;
}

/* ── La cola (WA_COLA): qué pedido es nuevo o cambió de día. Se escribe ADENTRO del candado de doPost. ── */
function waJsonProp_(k, def) { try { var v = JSON.parse(prop_(k) || 'null'); return v == null ? def : v; } catch (e) { return def; } }
function waColaLeer_() { var c = waJsonProp_('WA_COLA', []); return Array.isArray(c) ? c : []; }
function waColaGuardar_(c) {
  if (c.length > WA_COLA_TOPE) c = c.slice(c.length - WA_COLA_TOPE);
  try { PropertiesService.getScriptProperties().setProperty('WA_COLA', JSON.stringify(c)); } catch (e) {}
}
/** Lo llama doSave con la fila YA escrita (`viejo` = la fila de antes, o null si es nueva). Nunca frena un guardado.
    🚀 (2026-10-14-a) `adelanto` = el panel lo pasó de la TARDE a la MAÑANA del mismo día porque el camión salió con él cargado: al
    cliente le sale «cargado y en camino» (`e`) en vez del cambio de día, y a logística nada (ellos lo cargaron).
    📥 (2026-11-07-f, dueño, 08/11: «por cada pedido que generes en el panel, el bot me envíe un mensaje únicamente a mí con los datos del
    pedido… y recordarme que lo debo subir al TR4») `tr4` = lo cargó la revisión de correos (cargar_pedidos.py manda `tr4:1`): un pedido
    NUEVO lleva la marca y `waRepaso` le manda `pedido_correo_tr4` al PRIMERO de WA_DUENO (como el efectivo: el jefe no). */
function waAlGuardar_(viejo, rec, adelanto, tr4) {
  if (!waActivo_() || !rec) return;
  var id = String(rec.id || '');
  if (!id || id.indexOf('__') === 0 || String(rec.estado || '') === BORRADOR_EST || !rec.fecha) return;   // (12/10) por el estado, no por `kommo-`
  if (entregaAConfirmar_(rec)) return;   // 📦 (2026-10-30-a) «el cliente avisa cuándo»: nada al cliente ni a logística (sin fecha ya salía arriba)
  var ev = null, fV = viejo ? fmtDate(viejo[1]) : '', tV = viejo ? turnoNorm_(viejo[7]) : '';
  /* 📦 (2026-10-30-a) …y cuando a una venta «avisa cuándo» le ponen el día, `fV` está vacío: es NUEVA (confirmación con el día verdadero),
     no un «cambio de día». */
  if (!viejo || !fV) ev = { id:id, t:'n' };                       // nuevo, o recién le pusieron fecha (venta de tienda → entrega)
  else if (adelanto && fV === String(rec.fecha) && fV === waBo_(Date.now()).hoy && tV === 'PM' && turnoNorm_(rec.turno) === 'AM') ev = { id:id, t:'e', de:fV + '|PM' };   // solo HOY: otro día es un cambio común
  else if (fV !== String(rec.fecha) || tV !== turnoNorm_(rec.turno)) ev = { id:id, t:'c', de:fV + '|' + tV };
  if (!ev) return;
  if (tr4 && !viejo && ev.t === 'n') ev.tr4 = 1;                   // 📥 (2026-11-07-f) recién cargado desde el correo (DESPUÉS de la cadena de arriba)
  var cola = waColaLeer_(), ya = null, ms = Date.now();
  for (var i = 0; i < cola.length; i++) if (cola[i].id === id && cola[i].t !== 'g') { ya = cola[i]; break; }   // (2026-11-14-b) la venta grande (`g`) va aparte
  if (ya) {
    /* Nuevo + cambio = UN mensaje de nuevo con el día último; dos cambios = uno, desde el día de ANTES del primero.
       (2026-10-14-a) Un cambio que termina adelantado sale «en camino»; uno adelantado que después se mueve, como cambio de día. */
    if (ev.t === 'n') { ya.t = 'n'; delete ya.de; }
    if (ev.tr4) ya.tr4 = 1;
    else if (ya.t !== 'n') { if (ev.t === 'e') ya.t = 'e'; else if (ya.t === 'e') ya.t = 'c'; }
    ya.ms = ms;
  } else { ev.ms = ms; cola.push(ev); }
  waColaGuardar_(cola);
  waDespertar_();
}
/* Un disparador de una vez para que el mensaje salga a los ~2 minutos y no a los 5 del repaso. Uno solo a la vez. */
function waDespertar_() {
  if (typeof ScriptApp === 'undefined') return false;
  if (Number(prop_('WA_DESP_HASTA')) > Date.now()) return true;
  try {
    ScriptApp.newTrigger('waDespierta').timeBased().after(WA_ESPERA_MS + 15000).create();
    PropertiesService.getScriptProperties().setProperty('WA_DESP_HASTA', String(Date.now() + WA_ESPERA_MS + 90000));
    return true;
  } catch (e) { return false; }
}
function waDespierta() {
  kTriggersDe_('waDespierta').forEach(function (t) { try { ScriptApp.deleteTrigger(t); } catch (e) {} });
  try { PropertiesService.getScriptProperties().deleteProperty('WA_DESP_HASTA'); } catch (e) {}
  return waRepaso();
}

/* ============================================================================
 * 📉 §4ok-102 (2026-11-05-a) EL VIGÍA DE LEADS. Desde la tarde del 31/10 casi no entraban leads a Kommo (antes 71-123 por día; el
 * 01/11, 3; el 02/11, 1 hasta las 18:30). El dashboard lo pintaba en ámbar y nadie se enteró.
 *   · Una vez por hora (`waRepaso` corre cada 5 minutos y el vigía mira si pasó la hora: no hace falta otro disparador), de las 8:00 a
 *     las 22:59 de Bolivia, cualquier día: cuenta en Kommo (`kGet_`, solo lee) los leads creados en las últimas WA_LEADS_VENTANA_H
 *     horas y en las MISMAS horas de 7 días antes.
 *   · Si ahora entró menos del WA_LEADS_UMBRAL (25 %) de lo de la semana pasada, y la semana pasada fueron al menos WA_LEADS_MIN (8):
 *     `alerta_leads` a WA_DUENO, UNA vez (WA_LEADS.alerta), hasta que vuelvan.
 *   · Vuelven cuando ya no se cumple lo de arriba y entraron al menos WA_LEADS_VUELVEN (2): `alerta_leads_volvieron`, una vez.
 *   · Sin WA_DUENO (o sin KOMMO_TOKEN, o si Kommo no contesta) no hace nada; lo último que contó queda en WA_LEADS (sin nombres).
 * ========================================================================== */
var WA_LEADS_DESDE = 8, WA_LEADS_HASTA = 23;       // de las 8:00 a las 22:59 de Bolivia
var WA_LEADS_VENTANA_H = 3, WA_LEADS_UMBRAL = 0.25, WA_LEADS_MIN = 8, WA_LEADS_VUELVEN = 2;
var WA_LEADS_CADA_MS = 55 * 60000;                 // «cada hora» (con el repaso de 5 minutos, sale entre los 55 y los 60)
var WA_LEADS_PAGINAS = 8;                          // de a 250: hasta 2.000 leads en 3 horas
/** Cuántos leads se crearon en Kommo entre dos momentos (ms). null si Kommo no contesta. */
function waLeadsContar_(desde, hasta) {
  var n = 0, de = Math.floor(desde / 1000), a = Math.floor(hasta / 1000);
  for (var pg = 1; pg <= WA_LEADS_PAGINAS; pg++) {
    var o = kGet_('/leads?limit=250&page=' + pg + '&filter[created_at][from]=' + de + '&filter[created_at][to]=' + a);
    if (o == null) return null;
    var L = kEmb_(o, 'leads'); n += L.length;
    if (L.length < 250) break;
  }
  return n;
}
function waLeadsGuardar_(st) { try { PropertiesService.getScriptProperties().setProperty('WA_LEADS', JSON.stringify(st)); } catch (e) {} }
/** Lo llama el repaso (afuera del candado): [] o los mensajes al dueño. */
function waLeadsVigia_(cfg, B, t0) {
  if (!cfg.dueno || !cfg.dueno.length) return [];
  if (B.hora < WA_LEADS_DESDE || B.hora >= WA_LEADS_HASTA) return [];
  var st = waJsonProp_('WA_LEADS', {}) || {};
  if (t0 - (Number(st.ts) || 0) < WA_LEADS_CADA_MS) return [];
  st.ts = t0; waLeadsGuardar_(st);                 // primero: otra vuelta que arranque mientras tanto no cuenta de nuevo
  var V = WA_LEADS_VENTANA_H * 3600000, S7 = 7 * 86400000;
  var ahora = waLeadsContar_(t0 - V, t0), antes = ahora == null ? null : waLeadsContar_(t0 - S7 - V, t0 - S7);
  if (ahora == null || antes == null) { st.err = 'Kommo no contestó (o falta KOMMO_TOKEN)'; waLeadsGuardar_(st); return []; }
  st.n = ahora; st.n7 = antes; delete st.err;
  var cae = antes >= WA_LEADS_MIN && ahora < WA_LEADS_UMBRAL * antes, k = '';
  if (cae && !st.alerta) { st.alerta = t0; k = 'al'; }
  else if (st.alerta && !cae && ahora >= WA_LEADS_VUELVEN) { delete st.alerta; st.volvio = t0; k = 'alv'; }
  waLeadsGuardar_(st);
  if (!k) return [];
  return cfg.dueno.map(function (L) { return { k:k, a:L.nombre, dia:B.hoy, n:0, ld:{ t:t0, n:ahora, n7:antes } }; });
}
/** Los datos de `alerta_leads` / `alerta_leads_volvieron`: las horas, cuántos ahora, el día de hace una semana, cuántos entonces. */
function waLeadsParams_(ld) {
  var V = WA_LEADS_VENTANA_H * 3600000, h = function (ms) { return waBo_(ms).txt.slice(6); };
  var cu = function (n) { n = Number(n) || 0; return n === 1 ? '1 lead' : n + ' leads'; };
  return ['de ' + h(ld.t - V) + ' a ' + h(ld.t), cu(ld.n), waDiaTxt_(waBo_(ld.t - 7 * 86400000).hoy), cu(ld.n7)];
}
/** ▶ Desde el editor: cuenta lo de las últimas 3 horas y lo de hace una semana, SIN mandar nada ni tocar WA_LEADS. */
function probarVigiaLeads() {
  var t0 = Date.now(), V = WA_LEADS_VENTANA_H * 3600000, S7 = 7 * 86400000;
  var r = { ahora:waLeadsContar_(t0 - V, t0), semanaPasada:waLeadsContar_(t0 - S7 - V, t0 - S7), dueno:waConfig_().dueno.map(function (L) { return L.nombre; }), estado:waJsonProp_('WA_LEADS', null) };
  if (typeof Logger !== 'undefined') Logger.log(JSON.stringify(r, null, 2));
  return r;
}

/* ============================================================================
 * 🏭 §4ok-105 (2026-11-05-a) EL RECLAMO A LA FÁBRICA SALE SOLO CADA MAÑANA. Desde el 19/10, 32 de 177 unidades de lo que rota no
 * salieron de PTF/Banzer; el reclamo («Lo que nos debe la fábrica», `fdHtml`) se copiaba a mano y nadie lo abría.
 *   · La PÁGINA arma el reclamo al terminar los Excel del día (con su cuenta de siempre: `fdLista`, `stockData`) y lo deja en la fila
 *     del sistema `__reclamo_fab__` (JSON en «Observaciones»: {v, f, h, atr:[…], cero:[…]}, textos ya armados, sin plata ni clientes).
 *     El servidor no recalcula el stock: lee la fila de ESE momento.
 *   · A las 10:00 (días hábiles; hasta WA_VENTANA_H después) `reclamo_fabrica` al dueño (WA_DUENO) y a los de WA_AVISOS (o
 *     WA_PEDIR_HOY), sin repetir un número. Si la fila de hoy todavía no está, prueba cada 5 minutos hasta que esté. Sin nada atrasado,
 *     no sale. Solo avisa: no toca el stock ni los pedidos.
 * ========================================================================== */
var WA_RECLAMO_ID = '__reclamo_fab__';      // = RECLAMO_FAB_ID de la página
var WA_HORA_RECLAMO = 10;
var WA_RECLAMO_REINT_MS = 4.5 * 60000;      // mientras la fila de hoy no está, cada vuelta de 5 minutos
function waReclamoLeer_(r) {
  if (!r) return null;
  var o = null; try { o = JSON.parse(String(r.observaciones || '')); } catch (e) { o = null; }
  if (!o || typeof o !== 'object') return null;
  var lim = function (L) { return (Array.isArray(L) ? L : []).map(function (t) { return String(t || '').trim(); }).filter(function (t) { return !!t; }).slice(0, 40); };
  return { f:String(o.f || ''), h:String(o.h || ''), atr:lim(o.atr), cero:lim(o.cero) };
}
/** Los datos de `reclamo_fabrica`: el día, cuántos atrasados, cuáles, cuántos en 0 con ventas esperando, cuáles. */
function waReclamoParams_(R, B) {
  var cu = function (k) { return k ? k + ' producto' + (k === 1 ? '' : 's') : 'ninguno ✅'; };
  return [waDiaTxt_(B.hoy), cu(R.atr.length), R.atr.length ? waListaCabe_(R.atr.map(waParam_), ' · ') : '—',
          cu(R.cero.length), R.cero.length ? waListaCabe_(R.cero.map(waParam_), ' · ') : '—'];
}

/* ============================================================================
 * 💵 (2026-11-06-b, dueño 06/11: «avisar retiros de efectivo pendientes o sin cargar luego de 48 horas (aplica desde noviembre) y que
 * llegue a mi telf»; eligió «dos veces, 9:00 y 18:00») EL EFECTIVO QUE NADIE RETIRÓ, AL DUEÑO.
 *   · Lo cobrado en EFECTIVO —el adelanto, los cobros y el recargo por entrega ya cobrado (`contaPagos` de la página)— queda en la mano
 *     de quien lo recibió: el chofer si el cobro dice «>Nombre», si no la vendedora de la venta (`pagoRecibio`). Sin ATC, RPT, filas del
 *     sistema, borradores de Kommo, Eduardo, ROHO ni los pedidos internos (`WA_EFE_FUERA` = `CONTA_EXCLUIR` de la página: el Cuadre).
 *   · Cada retiro (`__ret_…`: «Vendedor» = quien entrega, «A cuenta» = el monto, `ts` = el día) cubre, de quien lo entregó, lo cobrado
 *     HASTA ese día: primero un cobro del MISMO monto (el más cercano antes del retiro: con la planilla del 06/11 casi todos los retiros
 *     son de un cobro entero), después del más viejo al más nuevo. Lo que sobra de un retiro no tapa lo que se cobre después.
 *   · Se empareja desde WA_EFE_EMPAREJA (01/10: un retiro de noviembre por efectivo de octubre no tapa lo de noviembre) y se avisa solo
 *     lo cobrado desde WA_EFE_DESDE (01/11) de ventas CARGADAS desde el 01/11 (06-e: lo de octubre ya se recogió) y de hace WA_EFE_DIAS (2)
 *     días o más: el cobro guarda el DÍA, no la hora, así que «48 horas» = lo del lunes avisa desde el miércoles.
 *   · A las 9:00 y a las 18:00 (lunes a sábado, no feriados; hasta WA_VENTANA_H después) `efectivo_del_dia`: lo de los VENDEDORES al dueño
 *     (WA_DUENO) y lo que recibieron los CHOFERES a Contabilidad (WA_CONTABILIDAD; 06-c). 📅 (06-d, dueño: «cada día… cuánto efectivo ingresó
