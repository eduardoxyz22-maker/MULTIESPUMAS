var LATIDOS_MAX = 40;             // dispositivos con cola que se recuerdan

function getSheetRechazos_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(RECHAZOS_HOJA);
